rules_version = '2';

// Classe A Barbearia — least-privilege rules.
// Appointments, payments, subscriptions, locks and roles are written only by Cloud Functions (Admin SDK).
// Roles come exclusively from the ID token custom claim `roles`; users/{uid}.role is a UI mirror only.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function hasRole(role) {
      return isSignedIn() && request.auth.token.roles is list && role in request.auth.token.roles;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    function isBarber() {
      return hasRole('barber');
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isHHmm(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function isEnd(v) {
      return isHHmm(v) || v == '24:00';
    }
    function validRange(r) {
      return r is map
        && r.keys().hasAll(['start', 'end'])
        && r.keys().hasOnly(['start', 'end', 'reason'])
        && isHHmm(r.start) && isEnd(r.end) && r.start < r.end
        && (!('reason' in r) || r.reason == null || (r.reason is string && r.reason.size() <= 40));
    }
    function rangeAt(list, i) {
      return list.size() <= i || validRange(list[i]);
    }
    // Rules have no loops, so ranges are validated index by index up to the allowed maximum.
    function validRanges(list, max) {
      return list is list && list.size() <= max
        && rangeAt(list, 0) && rangeAt(list, 1) && rangeAt(list, 2) && rangeAt(list, 3)
        && rangeAt(list, 4) && rangeAt(list, 5) && rangeAt(list, 6) && rangeAt(list, 7)
        && rangeAt(list, 8) && rangeAt(list, 9) && rangeAt(list, 10) && rangeAt(list, 11)
        && rangeAt(list, 12) && rangeAt(list, 13) && rangeAt(list, 14) && rangeAt(list, 15)
        && rangeAt(list, 16) && rangeAt(list, 17) && rangeAt(list, 18) && rangeAt(list, 19)
        && rangeAt(list, 20) && rangeAt(list, 21) && rangeAt(list, 22) && rangeAt(list, 23);
    }
    function validDay() {
      let d = request.resource.data;
      return d.keys().hasAll(['status', 'blocks', 'extraOpenings'])
        && d.keys().hasOnly(['status', 'blocks', 'extraOpenings', 'updatedAt', 'updatedBy'])
        && d.status in ['open', 'closed']
        && validRanges(d.blocks, 24)
        && validRanges(d.extraOpenings, 6)
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function isDateKey(v) {
      return v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Profiles are created by the completeProfile Function (it also records consents).
      allow create, delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'birthDate', 'avatarUrl'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.phone.matches('^\\+55[0-9]{2}9[0-9]{8}$');

      match /paymentMethods/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
      match /notifications/{id} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ---------- barbers ----------
    match /barbers/{barberId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(barberId) && isBarber()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bio', 'photoUrl', 'specialties', 'serviceIds', 'weeklyTemplate', 'slotIntervalMin', 'bufferMin'])
          && request.resource.data.slotIntervalMin in [15, 30, 45, 60]
          && request.resource.data.bufferMin is int && request.resource.data.bufferMin >= 0 && request.resource.data.bufferMin <= 30
          && request.resource.data.bio is string && request.resource.data.bio.size() <= 240);

      match /days/{date} {
        allow read: if (isOwner(barberId) && isBarber()) || isAdmin();
        allow create, update: if isDateKey(date) && ((isOwner(barberId) && isBarber()) || isAdmin()) && validDay();
        allow delete: if (isOwner(barberId) && isBarber()) || isAdmin();
      }
    }

    // Public, PII-free projection of each barber's day (HH:mm only). Written by Functions.
    match /availabilityPublic/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- catalogue ----------
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /legalDocs/{type} {
      allow read: if true;
      allow write: if isAdmin();
      match /versions/{v} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ---------- bookings & money (Functions only) ----------
    match /appointments/{id} {
      allow read: if (isSignedIn() && resource.data.clientId == request.auth.uid)
        || (isBarber() && resource.data.barberId == request.auth.uid)
        || isAdmin();
      allow write: if false;
    }
    match /slotLocks/{id} {
      allow read, write: if false;
    }
    match /subscriptions/{id} {
      allow read: if (isSignedIn() && resource.data.clientId == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if (isSignedIn() && resource.data.clientId == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /pixCharges/{id} {
      allow read: if (isSignedIn() && resource.data.clientId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // ---------- barber's client book ----------
    match /barberClients/{barberId}/clients/{clientId} {
      allow read: if (isOwner(barberId) && isBarber()) || isAdmin();
      allow update: if isOwner(barberId) && isBarber()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privateNotes'])
        && request.resource.data.privateNotes is string
        && request.resource.data.privateNotes.size() <= 1000;
      allow create, delete: if false;
    }

    // ---------- LGPD ----------
    match /consentLogs/{id} {
      allow create: if request.resource.data.keys().hasAll(['type', 'version', 'choices', 'userAgent', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'anonymousId', 'type', 'version', 'choices', 'userAgent', 'createdAt'])
        && request.resource.data.type in ['cookies', 'terms', 'privacy', 'marketing']
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.choices is map
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300
        && request.resource.data.createdAt == request.time
        && (('uid' in request.resource.data && isOwner(request.resource.data.uid))
          || (!('uid' in request.resource.data) && request.resource.data.anonymousId is string
            && request.resource.data.anonymousId.size() <= 64));
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /dataRequests/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'status', 'createdAt', 'details'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['export', 'delete', 'correct']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Trigger Email extension queue and anything not listed: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
