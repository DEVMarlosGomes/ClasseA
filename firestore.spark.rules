rules_version = '2';

// Classe A Barbearia — Spark (free plan) TEST rules. Deployed with `--config firebase.spark.json`.
//
// Without Cloud Functions the browser writes appointments, payments, subscriptions and locks itself
// (src/lib/spark), so these rules trust signed-in users much more than firestore.rules does.
// Personal data stays scoped to its owner, the barber and the admin, but a malicious client could
// forge bookings, mock payments or availability. Do not use these rules with real customers.
//
// Roles come from roles/{uid} (no custom claims without the Admin SDK). The first admin is created
// by scripts/bootstrap-production.ts or by hand in the console: roles/{uid} = { roles: ['admin'] }.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function rolesPath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function hasRole(role) {
      return isSignedIn() && exists(rolesPath()) && role in get(rolesPath()).data.roles;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    function isBarber() {
      return hasRole('barber');
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function isHHmm(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function isEnd(v) {
      return isHHmm(v) || v == '24:00';
    }
    function validRange(r) {
      return r is map
        && r.keys().hasAll(['start', 'end'])
        && r.keys().hasOnly(['start', 'end', 'reason'])
        && isHHmm(r.start) && isEnd(r.end) && r.start < r.end
        && (!('reason' in r) || r.reason == null || (r.reason is string && r.reason.size() <= 40));
    }
    function rangeAt(list, i) {
      return list.size() <= i || validRange(list[i]);
    }
    function validRanges(list, max) {
      return list is list && list.size() <= max
        && rangeAt(list, 0) && rangeAt(list, 1) && rangeAt(list, 2) && rangeAt(list, 3)
        && rangeAt(list, 4) && rangeAt(list, 5) && rangeAt(list, 6) && rangeAt(list, 7)
        && rangeAt(list, 8) && rangeAt(list, 9) && rangeAt(list, 10) && rangeAt(list, 11)
        && rangeAt(list, 12) && rangeAt(list, 13) && rangeAt(list, 14) && rangeAt(list, 15)
        && rangeAt(list, 16) && rangeAt(list, 17) && rangeAt(list, 18) && rangeAt(list, 19)
        && rangeAt(list, 20) && rangeAt(list, 21) && rangeAt(list, 22) && rangeAt(list, 23);
    }
    function validDay() {
      let d = request.resource.data;
      return d.keys().hasAll(['status', 'blocks', 'extraOpenings'])
        && d.keys().hasOnly(['status', 'blocks', 'extraOpenings', 'updatedAt', 'updatedBy'])
        && d.status in ['open', 'closed']
        && validRanges(d.blocks, 24)
        && validRanges(d.extraOpenings, 6)
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function isDateKey(v) {
      return v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- roles ----------
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Anyone may become a client; staff roles are granted by an admin only.
      allow create: if isOwner(uid) && request.resource.data.roles == ['client'];
      allow update: if isOwner(uid)
        && request.resource.data.roles.toSet() == resource.data.roles.toSet().union(['client'].toSet());
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin();
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'client' && request.resource.data.roles == ['client'];
      allow update: if isOwner(uid) && !changes().hasAny(['role', 'roles']);
      allow delete: if isOwner(uid);
      allow create, update, delete: if isAdmin();

      match /paymentMethods/{id} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin();
      }
      match /notifications/{id} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && changes().hasOnly(['read']);
        // Barbers and admins notify clients from the browser.
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['title', 'body', 'link', 'read', 'createdAt'])
          && request.resource.data.read == false;
      }
    }

    // ---------- barbers ----------
    match /barbers/{barberId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(barberId) && isBarber()
          && changes().hasOnly(['bio', 'photoUrl', 'specialties', 'serviceIds', 'weeklyTemplate', 'slotIntervalMin', 'bufferMin'])
          && request.resource.data.slotIntervalMin in [15, 30, 45, 60]
          && request.resource.data.bufferMin is int && request.resource.data.bufferMin >= 0 && request.resource.data.bufferMin <= 30
          && request.resource.data.bio is string && request.resource.data.bio.size() <= 240);

      match /days/{date} {
        // Clients compute availability in the browser, so day overrides are readable when signed in.
        allow read: if isSignedIn();
        allow create, update: if isDateKey(date) && ((isOwner(barberId) && isBarber()) || isAdmin()) && validDay();
        allow delete: if (isOwner(barberId) && isBarber()) || isAdmin();
      }
    }

    // PII-free projections maintained by the browser (HH:mm only).
    match /availabilityPublic/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /dayBusy/{id} {
      allow read, write: if isSignedIn();
    }
    match /slotLocks/{id} {
      allow read, write: if isSignedIn();
    }

    // ---------- catalogue ----------
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /legalDocs/{type} {
      allow read: if true;
      allow write: if isAdmin();
      match /versions/{v} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ---------- bookings & money ----------
    function ownsExisting() {
      return isSignedIn() && resource.data.clientId == request.auth.uid;
    }
    function ownsNew() {
      return isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    match /appointments/{id} {
      allow read: if ownsExisting() || (isBarber() && resource.data.barberId == request.auth.uid) || isAdmin();
      allow create: if ownsNew() && request.resource.data.status == 'confirmed';
      allow update: if ownsExisting() || (isBarber() && resource.data.barberId == request.auth.uid) || isAdmin();
      allow delete: if false;
    }
    match /subscriptions/{id} {
      allow read: if ownsExisting() || isBarber() || isAdmin();
      allow create: if ownsNew();
      // Barbers give a plan cut back when they cancel an appointment.
      allow update: if ownsExisting() || isBarber() || isAdmin();
      allow delete: if false;
    }
    match /payments/{id} {
      allow read: if ownsExisting() || isBarber() || isAdmin();
      allow create: if ownsNew();
      allow update: if ownsExisting() || isBarber() || isAdmin();
      allow delete: if false;
    }
    match /pixCharges/{id} {
      allow read: if (isSignedIn() && resource == null) || ownsExisting() || isAdmin();
      allow create: if ownsNew();
      allow update, delete: if ownsExisting();
    }

    // ---------- barber's client book ----------
    match /barberClients/{barberId}/clients/{clientId} {
      allow read: if (isOwner(barberId) && isBarber()) || isAdmin();
      allow write: if (isOwner(barberId) && isBarber()) || isAdmin();
      // The client's own actions refresh the stats, never the barber's private notes.
      allow create: if isOwner(clientId) && !('privateNotes' in request.resource.data);
      allow update: if isOwner(clientId) && !changes().hasAny(['privateNotes']);
      allow delete: if isOwner(clientId);
    }

    // ---------- LGPD ----------
    match /consentLogs/{id} {
      allow create: if request.resource.data.keys().hasAll(['type', 'version', 'choices', 'userAgent', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'anonymousId', 'type', 'version', 'choices', 'userAgent', 'createdAt'])
        && request.resource.data.type in ['cookies', 'terms', 'privacy', 'marketing']
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.choices is map
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300
        && request.resource.data.createdAt == request.time
        && (('uid' in request.resource.data && isOwner(request.resource.data.uid))
          || (!('uid' in request.resource.data) && request.resource.data.anonymousId is string
            && request.resource.data.anonymousId.size() <= 64));
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update, delete: if false;
    }
    match /dataRequests/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'status', 'createdAt', 'resolvedAt', 'details'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['export', 'delete', 'correct']
        && request.resource.data.status in ['open', 'done']
        && request.resource.data.createdAt == request.time;
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if (isSignedIn() && resource.data.uid == request.auth.uid && changes().hasOnly(['status', 'resolvedAt'])) || isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
