rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif)')
        && request.resource.size < 3 * 1024 * 1024;
    }
    function hasRole(role) {
      return request.auth != null && request.auth.token.roles is list && role in request.auth.token.roles;
    }

    // Client avatars: private to the owner.
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }

    // Barber photos are public (landing and booking).
    match /barbers/{barberId}/{file} {
      allow read: if true;
      allow write: if ((request.auth != null && request.auth.uid == barberId && hasRole('barber')) || hasRole('admin'))
        && isImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
