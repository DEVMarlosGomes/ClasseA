# Copy to functions/.env.classea-97dd2 (one file per Firebase project). Never put secrets here:
# MP_ACCESS_TOKEN and MP_WEBHOOK_SECRET live in Secret Manager (firebase functions:secrets:set).

# "mercadopago" moves real money (sandbox or production, depending on the access token).
# Unset or "mock" keeps the simulated gateway.
PAYMENTS_PROVIDER=mock

# Public URL of the mpWebhook function, sent as notification_url on PIX payments.
# Example: https://southamerica-east1-classea-97dd2.cloudfunctions.net/mpWebhook
MP_WEBHOOK_URL=

# ---------- InfinitePay (one-off PIX and card) ----------
# "infinitepay" turns on online payment for appointments. Also set the secret:
#   firebase functions:secrets:set INFINITEPAY_API_KEY   (inchk_..., from Configurações do Checkout)
ONLINE_PAYMENTS=
# InfiniteTag without the "$"
INFINITEPAY_HANDLE=
# Public site, for the return page: https://<domain>  (InfinitePay sends the client to /agendar/retorno)
SITE_URL=
# Public URL of the ipWebhook function, e.g. https://southamerica-east1-classea-97dd2.cloudfunctions.net/ipWebhook
IP_WEBHOOK_URL=
