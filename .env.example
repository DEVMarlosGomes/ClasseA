# Firebase web config (Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# reCAPTCHA Enterprise site key for App Check (production only)
VITE_RECAPTCHA_ENTERPRISE_KEY=
# "true" connects to the local Emulator Suite
VITE_USE_EMULATORS=true
# "true" enables the free-plan test backend (no Functions or Storage)
# O projeto oficial usa o plano Spark durante a homologacao. Use false apos publicar as Functions no Blaze.
VITE_SPARK=true
# Optional Sentry DSN
VITE_SENTRY_DSN=
# Public site URL (canonical, sitemap, OG)
VITE_SITE_URL=https://classea-97dd2.web.app
